{
  "name": "joboost",
  "displayName": "JOboost",
  "version": "1.0.0",
  "description": "JOboost - Platform d'affiliation et monétisation",
  "main": "index.js",
  "scripts": {
    "build": "cordova build android",
    "build:release": "cordova build android --release",
